# Clé secrète pour signer les jetons JWT (doit être longue et aléatoire)
JWT_SECRET=une_phrase_secrete_vraiment_longue_et_aleatoire_de_64_caracteres

# Chaîne de connexion MongoDB (utilise le conteneur Docker local par défaut)
MONGODB_ADDON_URI=mongodb://localhost:27017/lan_tournament
# Nom de la base de données (injecté automatiquement par Clever Cloud ou 'lan_tournament' en local)
MONGODB_ADDON_DB=lan_tournament

# Port d'écoute du serveur HTTP (optionnel, 8080 par défaut)
PORT=8080

# Stockage Objet S3 / Cellar (Obligatoire pour l'hébergement des captures d'écran des preuves)
CELLAR_ADDON_HOST=cellar-c2.services.clever-cloud.com
CELLAR_ADDON_KEY_ID=votre_cle_cellar_id
CELLAR_ADDON_KEY_SECRET=votre_cle_cellar_secrete
CELLAR_BUCKET_NAME=lan-tournament-proofs

APP_ENV=production
#ou autre chose si dans un autre contexte
